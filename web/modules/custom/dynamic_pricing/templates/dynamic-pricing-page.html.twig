{{ attach_library('dynamic_pricing/pricing_assets') }}

{# File: dynamic_pricing/templates/dynamic-pricing-page.html.twig #}
<nav class="navbar">
  <div class="navbar-container">
    <a class="navbar-brand" href="#">SDGE Pricing</a>
    <ul class="navbar-nav">
      <li><a class="nav-link active" href="#">Home</a></li>
      <li><a class="nav-link" href="#">Pricing Plans</a></li>
      <li><a class="nav-link" href="#">Contact Us</a></li>
    </ul>
  </div>
</nav>

<div class="pricing-container">
  <h2 class="title">Dynamic Day Ahead Pricing</h2>

  <div class="grid">
    {# === TODAY TABLE === #}
    <div class="grid-item">
      <h3 class="subtitle">Today</h3>
      <p class="muted">{{ today_date_display|date('F j, Y') }}</p>

      <div class="table-wrapper">
        <table class="pricing-table">
          <thead>
            <tr>
              <th colspan="3"></th>
              <th colspan="3" class="highlight">Total Prices ($/KWh)</th>
            </tr>
            <tr>
              <th>Hour</th>
              <th>CAISO Price</th>
              <th>GCC Adder</th>
              <th>Small</th>
              <th>Medium</th>
              <th>Large</th>
            </tr>
          </thead>
          <tbody>
            {% for item in today_data %}
              <tr>
                <td>{{ item.time }}</td>
                <td>{{ item.caiso_dep }}</td>
                <td>{{ item.gcc_adder }}</td>
                <td>{{ item.small }}</td>
                <td>{{ item.medium }}</td>
                <td>{{ item.large }}</td>
              </tr>
            {% else %}
              <tr><td colspan="6">No pricing data available for today.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# === TOMORROW TABLE === #}
    <div class="grid-item">
      <h3 class="subtitle">Tomorrow</h3>
      <p class="muted">{{ tomorrow_date_display|date('F j, Y') }}</p>

      <div class="table-wrapper">
        <table class="pricing-table">
          <thead>
            <tr>
              <th colspan="3"></th>
              <th colspan="3" class="highlight">Total Prices ($/KWh)</th>
            </tr>
            <tr>
              <th>Hour</th>
              <th>CAISO Price</th>
              <th>GCC Adder</th>
              <th>Small</th>
              <th>Medium</th>
              <th>Large</th>
            </tr>
          </thead>
          <tbody>
            {% for item in tomorrow_data %}
              <tr>
                <td>{{ item.time }}</td>
                <td>{{ item.caiso_dep }}</td>
                <td>{{ item.gcc_adder }}</td>
                <td>{{ item.small }}</td>
                <td>{{ item.medium }}</td>
                <td>{{ item.large }}</td>
              </tr>
            {% else %}
              <tr><td colspan="6">No pricing data available for tomorrow.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
